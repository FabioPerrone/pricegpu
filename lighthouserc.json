{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "_comment": "Three runs, asserted against the median. A single run on a shared CI runner swings 30 points under CPU contention — a byte-identical homepage scored 100 on one commit and 0.71 on the next, reporting 0 for DOM size on a 259-node page. One sample makes the gate a coin toss, and a gate people learn to re-run is not a gate.",
      "numberOfRuns": 3,
      "url": [
        "http://localhost/index.html",
        "http://localhost/gpu/h100-sxm/index.html",
        "http://localhost/compare/runpod-vs-vast-ai/index.html"
      ],
      "settings": {
        "chromeFlags": "--no-sandbox"
      }
    },
    "assert": {
      "preset": "lighthouse:recommended",
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "is-crawlable": "off",
        "network-dependency-tree-insight": "off",
        "render-blocking-insight": "off",
        "render-blocking-resources": "off",
        "unused-javascript": "off",
        "legacy-javascript": "off",
        "uses-long-cache-ttl": "off",
        "csp-xss": "off"
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
